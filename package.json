{
  "name": "dbt-guide-tutorial",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "A visual, hands-on guide to dbt — from beginner to expert. Static site generated from data + HTML fragments.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "assets": "node tools/vendor-assets.mjs",
    "check": "node tools/check.mjs",
    "verify": "node tools/build.mjs && node tools/check.mjs",
    "stage": "node tools/build.mjs && node tools/stage.mjs",
    "serve": "python3 -m http.server 8000",
    "clean": "node tools/build.mjs --clean"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "lucide-static": "^0.454.0",
    "prismjs": "^1.29.0"
  }
}
